{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/enonces-svg/:path*", "destination": "/app/enonces-svg/:path*" },
    { "source": "/avis-essai", "destination": "/avis-essai.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/crpe-2026-reforme-concours-externes", "destination": "/crpe-2026-reforme-concours-externes.html" },
    { "source": "/blog/crpe-bac3-structure-premiere-epreuve-admissibilite", "destination": "/crpe-bac3-structure-premiere-epreuve-admissibilite.html" },
    { "source": "/blog/salaire-professeur-des-ecoles-remuneration", "destination": "/salaire-professeur-des-ecoles-remuneration.html" },
    { "source": "/crpe-par-academie", "destination": "/crpe-par-academie.html" },
    { "source": "/crpe-par-academie/:slug", "destination": "/academies/:slug.html" },
    { "source": "/outils", "destination": "/outils.html" },
    { "source": "/outils/entraineur-crpe", "destination": "/entraineur-crpe.html" },
    { "source": "/outils/entraineur-crpe/rapport/:token", "destination": "/entraineur-rapport.html" },
    { "source": "/politique-de-confidentialite", "destination": "/politique-de-confidentialite.html" },
    { "source": "/admin-support", "destination": "/admin-support.html" },
    { "source": "/admin", "destination": "/app/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
